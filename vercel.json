{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/about-us",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/our-services",
      "destination": "/services/",
      "permanent": true
    },
    {
      "source": "/order",
      "destination": "/order/",
      "permanent": true
    },
    {
      "source": "/custom-order",
      "destination": "/order/",
      "permanent": true
    },
    {
      "source": "/ez-order",
      "destination": "/order/",
      "permanent": true
    },
    {
      "source": "/espirito-santo-parochial-uniform",
      "destination": "/espirito-santo/",
      "permanent": true
    },
    {
      "source": "/espirito-santo-school-uniform-order-page",
      "destination": "/espirito-santo/",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/category/all-products",
      "destination": "/school-stores/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/order/custom/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
